        "index": 94,
        "start": 185.84,
        "end": 187.52,
        "original_text": "那万一我们不恢复能力",
        "text": "Vậy lỡ như chúng ta không thể khôi phục năng lực thì sao?"
      },
      {
        "index": 95,
        "start": 187.52,
        "end": 189.18,
        "original_text": "不可能对付他",
        "text": "Thì không thể nào đối phó được với hắn ta!"
      },
      {
        "index": 96,
        "start": 189.18,
        "end": 190.38,
        "original_text": "成子皮",
        "text": "Thành Tử Bì"
      },
      {
        "index": 97,
        "start": 190.38,
        "end": 192.1,
        "original_text": "我们成为了傀儡",
        "text": "Chúng ta đã trở thành bù nhìn rồi."
      },
      {
        "index": 98,
        "start": 192.1,
        "end": 194.53,
        "original_text": "你也别想独善其身",
        "text": "Ngươi cũng đừng hòng thoát thân một mình!"
      },
      {
        "index": 99,
        "start": 194.53,
        "end": 196.37,
        "original_text": "成子皮看向窗口",
        "text": "Thành Tử Bì nhìn về phía cửa sổ."
      },
      {
        "index": 100,
        "start": 196.37,
        "end": 197.21,
        "original_text": "鬼面窗",
        "text": "Cửa sổ Quỷ Diện!"
      },
      {
        "index": 101,
        "start": 197.21,
        "end": 199.27,
        "original_text": "震慑",
        "text": "Chấn nhiếp!"
      },
      {
        "index": 102,
        "start": 199.27,
        "end": 200.51,
        "original_text": "接触这社时间",
        "text": "Trong chớp mắt..."
      },
      {
        "index": 103,
        "start": 200.51,
        "end": 202.15,
        "original_text": "成子皮撞碎了窗户",
        "text": "Thành Tử Bì đập vỡ cửa sổ."
      },
      {
        "index": 104,
        "start": 202.15,
        "end": 204.19,
        "original_text": "跳到校长室外的草场上",
        "text": "Nhảy xuống bãi cỏ bên ngoài phòng hiệu trưởng."
      },
      {
        "index": 105,
        "start": 204.19,
        "end": 205.07,
        "original_text": "头也不回得",
        "text": "Không hề ngoảnh đầu lại"
      },
      {
        "index": 106,
        "start": 205.07,
        "end": 209.07,
        "original_text": "朝着小孩子闹通的地方跑去",
        "text": "Chạy thẳng về phía nơi đám trẻ con đang nô đùa ầm ĩ."
      },
      {
        "index": 107,
        "start": 209.07,
        "end": 209.99,
        "original_text": "不敢追过来",
        "text": "Chúng không dám đuổi theo."
      },
      {
        "index": 108,
        "start": 210.11,
        "end": 211.11,
        "original_text": "果然",
        "text": "Quả nhiên!"
      },
      {
        "index": 109,
        "start": 211.11,
        "end": 213.35,
        "original_text": "他们没有胆子污染这些食物",
        "text": "Chúng không có gan làm ô uế những thức ăn này."
      },
      {
        "index": 110,
        "start": 213.35,
        "end": 215.11,
        "original_text": "还好我早有准备",
        "text": "May mà ta đã sớm có sự chuẩn bị."
      },
      {
        "index": 111,
        "start": 215.11,
        "end": 217.03,
        "original_text": "为了保证孩子的纯洁",
        "text": "Để đảm bảo sự thuần khiết của lũ trẻ,"
      },
      {
        "index": 112,
        "start": 217.03,
        "end": 218.67,
        "original_text": "童争鬼不会让孩子们看到",
        "text": "Đồng Chân Quỷ sẽ không để lũ trẻ nhìn thấy"
      },
      {
        "index": 113,
        "start": 218.67,
        "end": 220.23,
        "original_text": "一定点可怕的东西",
        "text": "Dù chỉ một chút thứ đáng sợ nào."
      },
      {
        "index": 114,
        "start": 220.23,
        "end": 221.43,
        "original_text": "坐在孩子堆里",
        "text": "Ngồi giữa đám đông trẻ con,"
      },
      {
        "index": 115,
        "start": 221.43,
        "end": 223.35,
        "original_text": "身中弥漫着欢声笑语",
        "text": "Xung quanh tràn ngập tiếng cười nói vui vẻ."
      },
      {
        "index": 116,
        "start": 223.35,
        "end": 225.71,
        "original_text": "谁能想到这些纯洁的孩统",
        "text": "Ai có thể ngờ rằng những đứa trẻ thuần khiết này"
      },
      {
        "index": 117,
        "start": 225.71,
        "end": 228.05,
        "original_text": "竟然都是鬼异的储粮",
        "text": "Lại chính là nguồn lương thực dự trữ của những kẻ quỷ dị."
      },
      {
        "index": 118,
        "start": 228.05,
        "end": 229.37,
        "original_text": "喂鬼面窗",
        "text": "Này Cửa sổ Quỷ Diện!"
      },
      {
        "index": 119,
        "start": 229.37,
        "end": 230.77,
        "original_text": "你还在吗",
        "text": "Ngươi vẫn còn ở đó chứ?"
      },
      {
        "index": 120,
        "start": 230.77,
        "end": 232.61,
        "original_text": "成子皮并没有得到回应",
        "text": "Thành Tử Bì không nhận được bất kỳ hồi đáp nào."
      },
      {
        "index": 121,
        "start": 232.61,
        "end": 234.13,
        "original_text": "看来是消耗太大",
        "text": "Có vẻ như đã tiêu hao quá nhiều năng lượng,"
      },
      {
        "index": 122,
        "start": 234.13,
        "end": 236.56,
        "original_text": "导致他又沉睡了",
        "text": "khiến cậu ấy lại chìm vào giấc ngủ."
      },
      {
        "index": 123,
        "start": 236.56,
        "end": 237.92,
        "original_text": "又挂机了",
        "text": "Lại ngủ say rồi."
      },
      {
        "index": 124,
        "start": 237.92,
        "end": 238.52,
        "original_text": "哎",
        "text": "Haizz..."
      },
      {
        "index": 125,
        "start": 238.52,
        "end": 239.2,
        "original_text": "看来",
        "text": "Có vẻ như"
      },
      {
        "index": 126,
        "start": 239.24,
        "end": 242.19,
        "original_text": "接下来又只有我一个人了",
        "text": "sắp tới lại chỉ còn một mình mình thôi."
      },
      {
        "index": 127,
        "start": 242.19,
        "end": 243.99,
        "original_text": "小程同学你怎么在这啊",
        "text": "Tiểu Trình, sao cậu lại ở đây?"
      },
      {
        "index": 128,
        "start": 243.99,
        "end": 245.11,
        "original_text": "你朋友呢",
        "text": "Bạn của cậu đâu rồi?"
      },
      {
        "index": 129,
        "start": 245.11,
        "end": 245.75,
        "original_text": "土豆",
        "text": "Đậu..."
      },
      {
        "index": 130,
        "start": 245.75,
        "end": 246.35,
        "original_text": "他们",
        "text": "Bọn họ..."
      },
      {
        "index": 131,
        "start": 246.35,
        "end": 247.83,
        "original_text": "他们和我吵架了",
        "text": "bọn họ cãi nhau với tớ rồi."
      },
      {
        "index": 132,
        "start": 247.83,
        "end": 248.51,
        "original_text": "对了",
        "text": "À mà này,"
      },
      {
        "index": 133,
        "start": 248.51,
        "end": 249.79,
        "original_text": "你的杨玉姐姐",
        "text": "chị Dương Ngọc của cậu"
      },
      {
        "index": 134,
        "start": 249.79,
        "end": 252.19,
        "original_text": "是什么时候开始夜里饿肚子的",
        "text": "bắt đầu bị đói bụng vào ban đêm từ khi nào vậy?"
      },
      {
        "index": 135,
        "start": 252.19,
        "end": 252.75,
        "original_text": "好像",
        "text": "Hình như..."
      },
      {
        "index": 136,
        "start": 252.75,
        "end": 254.67,
        "original_text": "好像是玉姐消失之后吧",
        "text": "hình như là sau khi chị Ngọc biến mất thì phải."
      },
      {
        "index": 137,
        "start": 254.67,
        "end": 256.23,
        "original_text": "玉姐又是谁",
        "text": "Chị Ngọc lại là ai?"
      },
      {
        "index": 138,
        "start": 256.23,
        "end": 258.07,
        "original_text": "以前被领养的一个女孩啊",
        "text": "Là một cô bé từng được nhận nuôi trước đây mà."
      },
      {
        "index": 139,
        "start": 258.07,
        "end": 260.3,
        "original_text": "就在你们来之前",
        "text": "Ngay trước khi các cậu đến."
      },
      {
        "index": 140,
        "start": 260.3,
        "end": 262.37,
        "original_text": "成子皮似乎想到什么",
        "text": "Thành Tử Bì dường như nghĩ ra điều gì đó."
      },
      {
        "index": 141,
        "start": 262.37,
        "end": 262.93,
        "original_text": "喂",
        "text": "Ê!"
      },
      {
        "index": 142,
        "start": 262.93,
        "end": 265.12,
        "original_text": "板块洗手吃饭了",
        "text": "Mọi người, rửa tay ăn cơm đi!"
      },
      {
        "index": 143,
        "start": 265.12,
        "end": 265.72,
        "original_text": "哦",
        "text": "Ồ,"
      },
      {
        "index": 144,
        "start": 265.72,
        "end": 266.8,
        "original_text": "来了来了",
        "text": "đến đây, đến đây!"
      },
      {
        "index": 145,
        "start": 266.8,
        "end": 268.56,
        "original_text": "土豆抓住成子皮的手",
        "text": "Đậu nắm lấy tay Thành Tử Bì,"
      },
      {
        "index": 146,
        "start": 268.56,
        "end": 276.06,
        "original_text": "超市堂前的洗手池走进",
        "text": "đi về phía bồn rửa tay ở sảnh siêu thị."
      },
      {
        "index": 147,
        "start": 276.06,
        "end": 277.62,
        "original_text": "011和013",
        "text": "011 và 013"
      },
      {
        "index": 148,
        "start": 277.62,
        "end": 282.58,
        "original_text": "还真是阴魂不散",
        "text": "đúng là âm hồn bất tán."
      },
      {
        "index": 149,
        "start": 282.58,
        "end": 283.26,
        "original_text": "我都忘了",
        "text": "Mình quên mất rồi,"
      },
      {
        "index": 150,
        "start": 283.26,
        "end": 284.94,
        "original_text": "杨玉姐已经被领养了",
        "text": "chị Dương Ngọc đã được nhận nuôi rồi."
      },
      {
        "index": 151,
        "start": 284.94,
        "end": 287.06,
        "original_text": "不需要再给她带机退了",
        "text": "Không cần mang cơm cho chị ấy nữa."
      },
      {
        "index": 152,
        "start": 287.06,
        "end": 289.22,
        "original_text": "成子皮看向土豆和马铃鼠",
        "text": "Thành Tử Bì nhìn Đậu và Mã Linh Thử,"
      },
      {
        "index": 153,
        "start": 289.22,
        "end": 290.7,
        "original_text": "有些预闷",
        "text": "cảm thấy hơi buồn."
      },
      {
        "index": 154,
        "start": 290.7,
        "end": 291.3,
        "original_text": "哎",
        "text": "Haizz..."
      },
      {
        "index": 155,
        "start": 291.3,
        "end": 292.38,
        "original_text": "看来现在",
        "text": "Có vẻ như bây giờ"
      },
      {
        "index": 156,
        "start": 292.38,
        "end": 294.26,
        "original_text": "我只能跟着这俩小家伙",
        "text": "mình chỉ có thể đi theo hai đứa nhóc này"
      },
      {
        "index": 157,
        "start": 294.26,
        "end": 297.14,
        "original_text": "才能保证自身安全了",
        "text": "mới đảm bảo được an toàn cho bản thân."
      },
      {
        "index": 158,
        "start": 297.14,
        "end": 297.74,
        "original_text": "饭后",
        "text": "Sau bữa ăn,"
      },
      {
        "index": 159,
        "start": 297.74,
        "end": 298.58,
        "original_text": "二楼五睡",
        "text": "trên lầu hai, mọi người đã ngủ."
      },
      {
        "index": 160,
        "start": 298.58,
        "end": 299.46,
        "original_text": "成子皮",
        "text": "Thành Tử Bì."
      },
      {
        "index": 161,
        "start": 299.46,
        "end": 300.02,
        "original_text": "土豆",
        "text": "Khoai tây"
      },
      {
        "index": 162,
        "start": 300.02,
        "end": 300.7,
        "original_text": "马铃鼠",
        "text": "Chuột đồng"
      },
      {
        "index": 163,
        "start": 300.7,
        "end": 302.94,
        "original_text": "三个人闭着眼却没睡着",
        "text": "Ba người nhắm mắt nhưng không ngủ"
      },
      {
        "index": 164,
        "start": 302.94,
        "end": 304.86,
        "original_text": "我想杨玉姐了",
        "text": "Tôi nhớ chị Yang Yu"
      },
      {
        "index": 165,
        "start": 304.86,
        "end": 305.94,
        "original_text": "我也是",
        "text": "Tôi cũng vậy"
      },
      {
        "index": 166,
        "start": 305.98,
        "end": 307.18,
        "original_text": "马铃鼠从怀里",
        "text": "Chuột đồng từ trong túi"
      },
      {
        "index": 167,
        "start": 307.18,
        "end": 309.46,
        "original_text": "掏出那个舞着眼睛的迷惑玩具",
        "text": "Lấy ra món đồ chơi lấp lánh mắt"
      },
      {
        "index": 168,
        "start": 309.46,
        "end": 312.31,
        "original_text": "还是小声的唾弃",
        "text": "Vẫn là tiếng thở dài nhỏ"
      },
      {
        "index": 169,
        "start": 312.31,
        "end": 312.95,
        "original_text": "不对",
        "text": "Không đúng"
      },
      {
        "index": 170,
        "start": 312.95,
        "end": 314.15,
        "original_text": "之前没注意",
        "text": "Trước đó tôi chưa để ý"
      },
      {
        "index": 171,
        "start": 314.15,
        "end": 316.59,
        "original_text": "这个迷惑玩具为什么舞着眼睛",
        "text": "Tại sao món đồ chơi này lại lấp lánh mắt"
      },
      {
        "index": 172,
        "start": 316.59,
        "end": 317.95,
        "original_text": "耳朵却被缝合了",
        "text": "Tai lại bị khâu lại"
      }
    ],
